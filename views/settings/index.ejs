<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Settings</h1>

    <div class="bg-white rounded-lg shadow p-8">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-lg font-semibold text-gray-800">Plan</h2>
          <p class="text-sm text-gray-500 mt-1">Controls which modules are available in the sidebar.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full text-xs font-bold tracking-wide uppercase
          <%= plan === 'pro' ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-600' %>">
          <%= plan %> plan
        </span>
      </div>

      <div class="border rounded-lg p-5 flex items-start justify-between gap-6">
        <div>
          <h3 class="font-medium text-gray-800 mb-1">Procurement modules</h3>
          <p class="text-sm text-gray-500 mb-2">
            Vendors, Bills, Expenses, Purchase Orders, and Vendor Credits — for tracking your own
            suppliers alongside your customer accounts.
          </p>
          <ul class="text-sm text-gray-500 list-disc list-inside">
            <li>Vendors</li>
            <li>Bills</li>
            <li>Expenses</li>
            <li>Purchase Orders</li>
            <li>Vendor Credits</li>
          </ul>
        </div>

        <% if (plan === 'pro') { %>
          <form action="/settings/plan" method="POST">
            <input type="hidden" name="plan" value="free">
            <button type="submit"
              class="whitespace-nowrap inline-flex items-center gap-2 border border-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-50 transition">
              Deactivate
            </button>
          </form>
        <% } else { %>
          <form action="/settings/plan" method="POST">
            <input type="hidden" name="plan" value="pro">
            <button type="submit"
              class="whitespace-nowrap inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium shadow-sm hover:bg-indigo-700 transition">
              Activate
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
