<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Users</h1>
      <p class="text-sm text-gray-500 mt-1">Who has access to your company, and what they can do.</p>
    </div>

    <% if (error) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"><%= error %></div>
    <% } %>

    <div class="overflow-x-auto bg-white rounded shadow mb-8">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Login</th>
            <% if (user.role === 'owner') { %>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
            <% } %>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% users.forEach(function(u) { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap"><%= [u.first_name, u.last_name].filter(Boolean).join(' ') || '-' %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= u.email %></td>
              <td class="px-6 py-4 whitespace-nowrap capitalize"><%= u.role.replace('_', ' ') %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= u.is_active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                  <%= u.is_active ? 'Active' : 'Deactivated' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                <%= u.last_login_at ? new Date(u.last_login_at).toLocaleString('en-US') : 'Never' %>
              </td>
              <% if (user.role === 'owner') { %>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <% if (u.id === user.id) { %>
                    <span class="text-gray-400 text-xs">(you)</span>
                  <% } else { %>
                    <form action="/settings/users/<%= u.id %>/role" method="POST" class="inline-block mr-2">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="role" onchange="this.form.requestSubmit()" class="border rounded px-2 py-1 text-xs">
                        <% roles.forEach(function(r) { %>
                          <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r.replace('_', ' ') %></option>
                        <% }); %>
                      </select>
                    </form>
                    <form action="/settings/users/<%= u.id %>/<%= u.is_active ? 'deactivate' : 'reactivate' %>" method="POST" class="inline-block">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="text-xs <%= u.is_active ? 'text-red-600' : 'text-green-600' %> hover:underline">
                        <%= u.is_active ? 'Deactivate' : 'Reactivate' %>
                      </button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (user.role === 'owner') { %>
      <div class="bg-white p-6 rounded-lg shadow max-w-lg">
        <h2 class="text-lg font-semibold mb-4">Add a User</h2>
        <form action="/settings/users/invite" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col">
              <label for="firstName" class="mb-1 font-medium text-gray-700 text-sm">First Name</label>
              <input type="text" id="firstName" name="firstName" class="border p-2 rounded w-full">
            </div>
            <div class="flex flex-col">
              <label for="lastName" class="mb-1 font-medium text-gray-700 text-sm">Last Name</label>
              <input type="text" id="lastName" name="lastName" class="border p-2 rounded w-full">
            </div>
          </div>

          <div class="flex flex-col">
            <label for="email" class="mb-1 font-medium text-gray-700 text-sm">Email</label>
            <input type="email" id="email" name="email" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col">
            <label for="role" class="mb-1 font-medium text-gray-700 text-sm">Role</label>
            <select id="role" name="role" class="border p-2 rounded w-full" required>
              <option value="">— Select a role —</option>
              <% roles.forEach(function(r) { %>
                <option value="<%= r %>"><%= r.replace('_', ' ') %></option>
              <% }); %>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="password" class="mb-1 font-medium text-gray-700 text-sm">Temporary Password</label>
            <input type="password" id="password" name="password" class="border p-2 rounded w-full" minlength="8" required>
            <span class="text-xs text-gray-400 mt-1">
              At least 8 characters. Share this with them directly — there's no email invite system yet, so they'll need it from you to log in.
            </span>
          </div>

          <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
            Add User
          </button>
        </form>
      </div>
    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
