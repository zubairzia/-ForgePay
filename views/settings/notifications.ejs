<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Notifications</h1>
      <p class="text-sm text-gray-500 mt-1">
        Payment reminders sent to customers. No SMS/WhatsApp/email provider is configured yet, so deliveries are logged to the server console rather than actually sent.
      </p>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Sent</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Channel</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recipient</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Template</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (notifications.length === 0) { %>
            <tr><td colspan="7" class="px-6 py-8 text-center text-gray-400">No notifications sent yet</td></tr>
          <% } %>
          <% notifications.forEach(function(n) { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= new Date(n.created_at).toLocaleString('en-US') %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= n.customer_name || '-' %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (n.credit_account_id) { %>
                  <a href="/credit-accounts/<%= n.credit_account_id %>/view" class="text-blue-600 hover:underline"><%= n.account_number %></a>
                <% } else { %>-<% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap capitalize"><%= n.channel %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= n.recipient %></td>
              <td class="px-6 py-4 whitespace-nowrap font-mono text-xs"><%= n.template_key %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%=
                  n.status === 'sent' ? 'bg-green-100 text-green-700' :
                  n.status === 'failed' ? 'bg-red-100 text-red-700' :
                  'bg-yellow-100 text-yellow-700'
                %>" title="<%= n.error_message || '' %>"><%= n.status %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
