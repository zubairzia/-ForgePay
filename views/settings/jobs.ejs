<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto">

    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Scheduled Jobs</h1>
        <p class="text-sm text-gray-500 mt-1">
          Recent runs of the daily status/late-fee job. Runs every night at 2:00 AM.
        </p>
      </div>
      <form action="/settings/jobs/run" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
          Run Now
        </button>
      </form>
    </div>

    <% if (error) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"><%= error %></div>
    <% } %>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Job</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Started</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Finished</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Records</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Error</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (runs.length === 0) { %>
            <tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">No job runs yet</td></tr>
          <% } %>
          <% runs.forEach(function(run) { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap font-mono text-xs"><%= run.job_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= new Date(run.started_at).toLocaleString('en-US') %></td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= run.finished_at ? new Date(run.finished_at).toLocaleString('en-US') : '—' %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%=
                  run.status === 'success' ? 'bg-green-100 text-green-700' :
                  run.status === 'failed' ? 'bg-red-100 text-red-700' :
                  'bg-yellow-100 text-yellow-700'
                %>"><%= run.status %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right"><%= run.records_processed ?? '—' %></td>
              <td class="px-6 py-4 max-w-xs truncate text-red-600 text-xs" title="<%= run.error_message || '' %>"><%= run.error_message || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
