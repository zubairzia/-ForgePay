<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Edit Company</h1>

    <form action="/companies/<%= company.id %>/update" method="POST" class="space-y-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <h2 class="text-lg font-semibold mb-4">Company Details</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label for="name" class="mb-1 font-medium text-gray-700">Name</label>
            <input type="text" id="name" name="name" value="<%= company.name || '' %>" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="legalName" class="mb-1 font-medium text-gray-700">Legal Name</label>
            <input type="text" id="legalName" name="legalName" value="<%= company.legal_name || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="industry" class="mb-1 font-medium text-gray-700">Industry</label>
            <input type="text" id="industry" name="industry" value="<%= company.industry || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="country" class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" id="country" name="country" value="<%= company.country || '' %>" maxlength="2" class="border p-2 rounded w-full uppercase">
          </div>

          <div class="flex flex-col">
            <label for="currency" class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" id="currency" name="currency" value="<%= company.currency || '' %>" maxlength="3" class="border p-2 rounded w-full uppercase">
          </div>

          <div class="flex flex-col">
            <label for="timezone" class="mb-1 font-medium text-gray-700">Timezone</label>
            <input type="text" id="timezone" name="timezone" value="<%= company.timezone || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="subscriptionPlan" class="mb-1 font-medium text-gray-700">Subscription Plan</label>
            <select id="subscriptionPlan" name="subscriptionPlan" class="border p-2 rounded w-full">
              <option value="trial" <%= company.subscription_plan === 'trial' ? 'selected' : '' %>>Trial</option>
              <option value="pro" <%= company.subscription_plan === 'pro' ? 'selected' : '' %>>Pro</option>
              <option value="enterprise" <%= company.subscription_plan === 'enterprise' ? 'selected' : '' %>>Enterprise</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="status" class="mb-1 font-medium text-gray-700">Status</label>
            <select id="status" name="status" class="border p-2 rounded w-full">
              <option value="active" <%= company.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="suspended" <%= company.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
              <option value="cancelled" <%= company.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>

        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">Grace Period &amp; Late Fees</h2>
        <p class="text-sm text-gray-500 mb-4">
          Controls the nightly job that marks installments overdue and applies late fees.
        </p>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="gracePeriodDays" class="mb-1 font-medium text-gray-700">Grace Period (days)</label>
            <input type="number" min="0" step="1" id="gracePeriodDays" name="gracePeriodDays"
                   value="<%= company.grace_period_days ?? 0 %>" class="border p-2 rounded w-full">
            <span class="text-xs text-gray-400 mt-1">Days past the due date before an installment counts as overdue.</span>
          </div>

          <div></div>

          <div class="flex flex-col">
            <label for="lateFeeType" class="mb-1 font-medium text-gray-700">Late Fee Type</label>
            <select id="lateFeeType" name="lateFeeType" class="border p-2 rounded w-full">
              <option value="none" <%= company.late_fee_type === 'none' ? 'selected' : '' %>>None</option>
              <option value="fixed" <%= company.late_fee_type === 'fixed' ? 'selected' : '' %>>Fixed amount</option>
              <option value="percentage" <%= company.late_fee_type === 'percentage' ? 'selected' : '' %>>Percentage of amount owed</option>
            </select>
          </div>

          <div class="flex flex-col late-fee-field">
            <label for="lateFeeAmount" class="mb-1 font-medium text-gray-700">Late Fee Amount</label>
            <input type="number" min="0" step="0.01" id="lateFeeAmount" name="lateFeeAmount"
                   value="<%= company.late_fee_amount ?? 0 %>" class="border p-2 rounded w-full">
            <span id="lateFeeAmountHint" class="text-xs text-gray-400 mt-1">
              A flat currency amount, or a percentage point (5 = 5%), depending on the type above.
            </span>
          </div>

          <div class="flex flex-col late-fee-field">
            <label for="lateFeeApplies" class="mb-1 font-medium text-gray-700">Applies</label>
            <select id="lateFeeApplies" name="lateFeeApplies" class="border p-2 rounded w-full">
              <option value="once" <%= company.late_fee_applies === 'once' ? 'selected' : '' %>>Once (charged one time)</option>
              <option value="daily" <%= company.late_fee_applies === 'daily' ? 'selected' : '' %>>Daily (charged again every day overdue)</option>
              <option value="per_period" <%= company.late_fee_applies === 'per_period' ? 'selected' : '' %>>Per period (charged again on the account's own installment cadence)</option>
            </select>
            <span class="text-xs text-amber-600 mt-1">
              Percentage + Daily compounds fast on a large overdue balance — review carefully before enabling that combination.
            </span>
          </div>

        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="/companies" class="text-gray-600 hover:text-gray-900">← Back to Companies</a>
        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition">
          Update Company
        </button>
      </div>

    </form>

  </div>

</main>

<script>
  // Hide the amount/cadence fields entirely when no late fee is configured
  // -- matches the pattern in public/js/customer-form.js for
  // conditionally-relevant fields.
  const lateFeeType = document.getElementById('lateFeeType');
  const lateFeeFields = document.querySelectorAll('.late-fee-field');
  const syncLateFeeFields = () => {
    const show = lateFeeType.value !== 'none';
    lateFeeFields.forEach((el) => { el.style.display = show ? '' : 'none'; });
  };
  lateFeeType.addEventListener('change', syncLateFeeFields);
  syncLateFeeFields();
</script>

<%- include('../partials/footer') %>
