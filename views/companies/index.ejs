<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="flex justify-center mb-6">
      <div class="w-full max-w-2xl relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="companySearch"
          type="text"
          placeholder="Filter companies..."
          class="border rounded-lg pl-10 pr-3 py-2.5 w-full shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          autocomplete="off"
        >
      </div>
    </div>

    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Companies</h1>
        <p class="text-sm text-gray-500 mt-1">Tenants provisioned on this platform.</p>
      </div>
      <a href="/companies/create"
         class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
        + New Company
      </a>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Industry</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Country</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Plan</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          </tr>
        </thead>
        <tbody id="companiesTable" class="bg-white divide-y divide-gray-200">
          <!-- JS will populate rows -->
        </tbody>
      </table>
    </div>

  </div>

</main>

<script src="/js/companies.js"></script>

<%- include('../partials/footer') %>
