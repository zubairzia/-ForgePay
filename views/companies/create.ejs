<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Create New Company</h1>

    <form action="/companies/create" method="POST" class="space-y-10">

      <div>
        <h2 class="text-lg font-semibold mb-4">Company Details</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label for="name" class="mb-1 font-medium text-gray-700">Name</label>
            <input type="text" id="name" name="name" placeholder="Company name" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="legalName" class="mb-1 font-medium text-gray-700">Legal Name</label>
            <input type="text" id="legalName" name="legalName" placeholder="Legal / registered name" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="industry" class="mb-1 font-medium text-gray-700">Industry</label>
            <input type="text" id="industry" name="industry" placeholder="e.g. Consumer Lending" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="country" class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" id="country" name="country" placeholder="ISO code, e.g. SA" maxlength="2" class="border p-2 rounded w-full uppercase">
          </div>

          <div class="flex flex-col">
            <label for="currency" class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" id="currency" name="currency" placeholder="ISO code, e.g. SAR" maxlength="3" class="border p-2 rounded w-full uppercase">
          </div>

          <div class="flex flex-col">
            <label for="timezone" class="mb-1 font-medium text-gray-700">Timezone</label>
            <input type="text" id="timezone" name="timezone" placeholder="e.g. Asia/Riyadh" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="subscriptionPlan" class="mb-1 font-medium text-gray-700">Subscription Plan</label>
            <select id="subscriptionPlan" name="subscriptionPlan" class="border p-2 rounded w-full">
              <option value="trial" selected>Trial</option>
              <option value="pro">Pro</option>
              <option value="enterprise">Enterprise</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="status" class="mb-1 font-medium text-gray-700">Status</label>
            <select id="status" name="status" class="border p-2 rounded w-full">
              <option value="active" selected>Active</option>
              <option value="suspended">Suspended</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>

        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="/companies" class="text-gray-600 hover:text-gray-900">← Back to Companies</a>
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Save Company
        </button>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
