<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Customer Details</h1>

    <form class="space-y-10">

      <!-- BASIC INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Basic Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">First Name</label>
            <input type="text" value="<%= customer.first_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Last Name</label>
            <input type="text" value="<%= customer.last_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Company Name</label>
            <input type="text" value="<%= customer.company_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Display Name</label>
            <input type="text" value="<%= customer.display_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Email</label>
            <input type="email" value="<%= customer.email || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Phone</label>
            <input type="text" value="<%= customer.phone || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Mobile</label>
            <input type="text" value="<%= customer.mobile || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Website</label>
            <input type="text" value="<%= customer.website || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- BILLING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Billing Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" value="<%= customer.billing_street || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" value="<%= customer.billing_city || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" value="<%= customer.billing_state || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" value="<%= customer.billing_postal_code || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" value="<%= customer.billing_country || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- SHIPPING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Shipping Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" value="<%= customer.shipping_street || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" value="<%= customer.shipping_city || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" value="<%= customer.shipping_state || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" value="<%= customer.shipping_postal_code || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" value="<%= customer.shipping_country || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- FINANCIAL INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Financial Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Tax Number</label>
            <input type="text" value="<%= customer.tax_number || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Credit Limit</label>
            <input type="number" value="<%= customer.credit_limit || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" value="<%= customer.currency || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Tax ID</label>
            <input type="text" value="<%= customer.tax_id || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Is Taxable</label>
            <input type="text" value="<%= customer.is_taxable ? 'Yes' : 'No' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- CRM INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">CRM Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Status</label>
            <input type="text" value="<%= customer.status || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Customer Type</label>
            <input type="text" value="<%= customer.customer_type || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Source</label>
            <input type="text" value="<%= customer.source || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Notes</label>
            <textarea class="border p-2 rounded w-full" disabled><%= customer.notes || '' %></textarea>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Tags</label>
            <input type="text" value="<%= customer.tags || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- BACK BUTTON -->
      <div class="flex justify-between items-center mt-6">
        <a href="/customers/" class="bg-yellow-500 text-white px-6 py-2 rounded hover:bg-yellow-600 transition">
          ← Back to Customers
        </a>
        
        <a href="/customers/<%= customer.customer_code %>/edit" class="bg-yellow-500 text-white px-6 py-2 rounded hover:bg-yellow-600 transition">
          Edit Customer
        </a>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>