<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <a href="/customers/" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Customers
    </a>

    <div class="flex justify-between items-center mb-8 pb-4 border-b">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Customer Details</h1>
        <p class="text-sm text-gray-500 mt-1"><%= customer.customer_code %></p>
      </div>

      <a href="/customers/<%= customer.customer_code %>/edit"
         class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm hover:bg-blue-700 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit Customer
      </a>
    </div>

    <form class="space-y-10">

      <!-- BASIC INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Basic Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">First Name</label>
            <input type="text" value="<%= customer.first_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Last Name</label>
            <input type="text" value="<%= customer.last_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Company Name</label>
            <input type="text" value="<%= customer.company_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Display Name</label>
            <input type="text" value="<%= customer.display_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Email</label>
            <input type="email" value="<%= customer.email || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Phone</label>
            <input type="text" value="<%= customer.phone || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Mobile</label>
            <input type="text" value="<%= customer.mobile || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Website</label>
            <input type="text" value="<%= customer.website || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- IDENTITY & KYC -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Identity &amp; KYC</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">National ID</label>
            <input type="text" value="<%= customer.national_id || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Date of Birth</label>
            <input type="text" value="<%= customer.date_of_birth ? new Date(customer.date_of_birth).toLocaleDateString() : '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Secondary Phone</label>
            <input type="text" value="<%= customer.secondary_phone || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">KYC Status</label>
            <input type="text" value="<%= customer.kyc_status || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">KYC Verified At</label>
            <input type="text" value="<%= customer.kyc_verified_at ? new Date(customer.kyc_verified_at).toLocaleString() : '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- BILLING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Billing Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" value="<%= customer.billing_street || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" value="<%= customer.billing_city || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" value="<%= customer.billing_state || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" value="<%= customer.billing_postal_code || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" value="<%= customer.billing_country || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- SHIPPING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Shipping Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" value="<%= customer.shipping_street || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" value="<%= customer.shipping_city || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" value="<%= customer.shipping_state || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" value="<%= customer.shipping_postal_code || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" value="<%= customer.shipping_country || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- CREDIT RISK -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Credit Risk</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Risk Rating</label>
            <input type="text" value="<%= customer.risk_rating || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Credit Score</label>
            <input type="text" value="<%= customer.credit_score || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Blacklisted</label>
            <input type="text" value="<%= customer.is_blacklisted ? 'Yes' : 'No' %>" class="border p-2 rounded w-full <%= customer.is_blacklisted ? 'text-red-600 font-semibold' : '' %>" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Blacklist Reason</label>
            <input type="text" value="<%= customer.blacklist_reason || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Guarantor Name</label>
            <input type="text" value="<%= customer.guarantor_name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Guarantor Phone</label>
            <input type="text" value="<%= customer.guarantor_phone || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Guarantor National ID</label>
            <input type="text" value="<%= customer.guarantor_national_id || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Guarantor Relationship</label>
            <input type="text" value="<%= customer.guarantor_relationship || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- FINANCIAL -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Financial</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">VAT Registration Number</label>
            <input type="text" value="<%= customer.vat_registration_number || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">CR Number</label>
            <input type="text" value="<%= customer.cr_number || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Credit Limit</label>
            <input type="number" value="<%= customer.credit_limit || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" value="<%= customer.currency || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Is Taxable</label>
            <input type="text" value="<%= customer.is_taxable ? 'Yes' : 'No' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Preferred Payment Method</label>
            <input type="text" value="<%= customer.preferred_payment_method || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Opening Balance</label>
            <input type="text" value="<%= customer.opening_balance || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Payment Terms (days)</label>
            <input type="text" value="<%= customer.payment_terms_days || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Preferred Language</label>
            <input type="text" value="<%= customer.preferred_language || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <!-- OPERATIONAL -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Operational</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Assigned Agent ID</label>
            <input type="text" value="<%= customer.assigned_agent_id || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Customer Since</label>
            <input type="text" value="<%= customer.customer_since ? new Date(customer.customer_since).toLocaleDateString() : '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Metadata</label>
            <textarea class="border p-2 rounded w-full font-mono text-sm" disabled><%= customer.metadata ? JSON.stringify(customer.metadata) : '' %></textarea>
          </div>

        </div>
      </div>

      <!-- CRM INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">CRM Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Status</label>
            <input type="text" value="<%= customer.status || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Customer Type</label>
            <input type="text" value="<%= customer.customer_type || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Source</label>
            <input type="text" value="<%= customer.source || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Notes</label>
            <textarea class="border p-2 rounded w-full" disabled><%= customer.notes || '' %></textarea>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Tags</label>
            <input type="text" value="<%= customer.tags || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
