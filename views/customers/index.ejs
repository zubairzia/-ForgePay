<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div id="customerToast" class="hidden mb-6 flex items-start gap-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-amber-800">
      <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
      </svg>
      <div class="flex-1">
        <p id="customerToastMessage" class="text-sm font-medium"></p>
      </div>
      <button type="button" id="customerToastClose" class="text-amber-500 hover:text-amber-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="flex justify-center mb-6">
      <div class="w-full max-w-2xl relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="customerSearch"
          type="text"
          placeholder="Search customers..."
          class="border rounded-lg pl-10 pr-3 py-2.5 w-full shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          autocomplete="off"
        >
        <div id="customerSearchResults" class="absolute bg-white border w-full mt-1 max-h-64 overflow-auto hidden z-50 rounded-lg shadow-lg"></div>
      </div>
    </div>

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Customers</h1>
      <a href="/customers/create"
         class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
        + New Customer
      </a>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Company Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created Time</th>
          </tr>
        </thead>
        <tbody id="customersTable" class="bg-white divide-y divide-gray-200">
          <!-- JS will populate rows -->
        </tbody>
      </table>
    </div>

  </div>

</main>

<script src="/js/customers.js"></script>

<%- include('../partials/footer') %>