<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Create New Customer</h1>

    <form action="/customers/create" method="POST" class="space-y-10">

      <!-- BASIC INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Basic Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="firstName" class="mb-1 font-medium text-gray-700">First Name</label>
            <input type="text" id="firstName" name="firstName" placeholder="First Name" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col">
            <label for="lastName" class="mb-1 font-medium text-gray-700">Last Name</label>
            <input type="text" id="lastName" name="lastName" placeholder="Last Name" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="companyName" class="mb-1 font-medium text-gray-700">Company Name</label>
            <input type="text" id="companyName" name="companyName" placeholder="Company Name" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="displayName" class="mb-1 font-medium text-gray-700">Display Name</label>
            <input type="text" id="displayName" name="displayName" placeholder="Display Name" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="email" class="mb-1 font-medium text-gray-700">Email</label>
            <input type="email" id="email" name="email" placeholder="Email" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col">
            <label for="phone" class="mb-1 font-medium text-gray-700">Phone</label>
            <input type="text" id="phone" name="phone" placeholder="Phone" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="mobile" class="mb-1 font-medium text-gray-700">Mobile</label>
            <input type="text" id="mobile" name="mobile" placeholder="Mobile" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="website" class="mb-1 font-medium text-gray-700">Website</label>
            <input type="text" id="website" name="website" placeholder="Website" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- IDENTITY & KYC -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Identity &amp; KYC</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="nationalId" class="mb-1 font-medium text-gray-700">National ID</label>
            <input type="text" id="nationalId" name="nationalId" placeholder="CNIC / Iqama / National ID" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="dateOfBirth" class="mb-1 font-medium text-gray-700">Date of Birth</label>
            <input type="date" id="dateOfBirth" name="dateOfBirth" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="secondaryPhone" class="mb-1 font-medium text-gray-700">Secondary Phone</label>
            <input type="text" id="secondaryPhone" name="secondaryPhone" placeholder="Secondary Phone" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="kycStatus" class="mb-1 font-medium text-gray-700">KYC Status</label>
            <select id="kycStatus" name="kycStatus" class="border p-2 rounded w-full">
              <option value="pending" selected>Pending</option>
              <option value="verified">Verified</option>
              <option value="rejected">Rejected</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="kycVerifiedAt" class="mb-1 font-medium text-gray-700">KYC Verified At</label>
            <input type="datetime-local" id="kycVerifiedAt" name="kycVerifiedAt" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- BILLING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Billing Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label for="billingStreet" class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" id="billingStreet" name="billingStreet" placeholder="Street" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingCity" class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" id="billingCity" name="billingCity" placeholder="City" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingState" class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" id="billingState" name="billingState" placeholder="State" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingPostalCode" class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" id="billingPostalCode" name="billingPostalCode" placeholder="Postal Code" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingCountry" class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" id="billingCountry" name="billingCountry" placeholder="Country" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- SHIPPING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Shipping Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label for="shippingStreet" class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" id="shippingStreet" name="shippingStreet" placeholder="Street" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="shippingCity" class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" id="shippingCity" name="shippingCity" placeholder="City" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="shippingState" class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" id="shippingState" name="shippingState" placeholder="State" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="shippingPostalCode" class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" id="shippingPostalCode" name="shippingPostalCode" placeholder="Postal Code" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="shippingCountry" class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" id="shippingCountry" name="shippingCountry" placeholder="Country" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- CREDIT RISK -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Credit Risk</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="riskRating" class="mb-1 font-medium text-gray-700">Risk Rating</label>
            <select id="riskRating" name="riskRating" class="border p-2 rounded w-full">
              <option value="">— Not rated —</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="creditScore" class="mb-1 font-medium text-gray-700">Credit Score</label>
            <input type="number" min="1" step="1" id="creditScore" name="creditScore" placeholder="External score, if available" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="isBlacklisted" class="mb-1 font-medium text-gray-700">Blacklisted</label>
            <select id="isBlacklisted" name="isBlacklisted" class="border p-2 rounded w-full">
              <option value="No" selected>No</option>
              <option value="Yes">Yes</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="blacklistReason" class="mb-1 font-medium text-gray-700">Blacklist Reason</label>
            <input type="text" id="blacklistReason" name="blacklistReason" placeholder="Reason (if blacklisted)" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="guarantorName" class="mb-1 font-medium text-gray-700">Guarantor Name</label>
            <input type="text" id="guarantorName" name="guarantorName" placeholder="Guarantor Name" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="guarantorPhone" class="mb-1 font-medium text-gray-700">Guarantor Phone</label>
            <input type="text" id="guarantorPhone" name="guarantorPhone" placeholder="Guarantor Phone" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="guarantorNationalId" class="mb-1 font-medium text-gray-700">Guarantor National ID</label>
            <input type="text" id="guarantorNationalId" name="guarantorNationalId" placeholder="Guarantor National ID" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="guarantorRelationship" class="mb-1 font-medium text-gray-700">Guarantor Relationship</label>
            <input type="text" id="guarantorRelationship" name="guarantorRelationship" placeholder="e.g. Spouse, Sibling, Employer" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- FINANCIAL -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Financial</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="vatRegistrationNumber" class="mb-1 font-medium text-gray-700">VAT Registration Number</label>
            <input type="text" id="vatRegistrationNumber" name="vatRegistrationNumber" placeholder="VAT Registration Number" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="crNumber" class="mb-1 font-medium text-gray-700">CR Number</label>
            <input type="text" id="crNumber" name="crNumber" placeholder="Commercial Registration Number" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="creditLimit" class="mb-1 font-medium text-gray-700">Credit Limit</label>
            <input type="number" id="creditLimit" name="creditLimit" placeholder="Credit Limit" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="currency" class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" id="currency" name="currency" placeholder="Currency" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="isTaxable" class="mb-1 font-medium text-gray-700">Is Taxable</label>
            <select id="isTaxable" name="isTaxable" class="border p-2 rounded w-full">
              <option value="Yes" selected>Yes</option>
              <option value="No">No</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="preferredPaymentMethod" class="mb-1 font-medium text-gray-700">Preferred Payment Method</label>
            <input type="text" id="preferredPaymentMethod" name="preferredPaymentMethod" placeholder="e.g. Bank Transfer, Cash" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="openingBalance" class="mb-1 font-medium text-gray-700">Opening Balance</label>
            <input type="number" step="0.01" id="openingBalance" name="openingBalance" placeholder="0.00" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="paymentTermsDays" class="mb-1 font-medium text-gray-700">Payment Terms (days)</label>
            <input type="number" min="0" step="1" id="paymentTermsDays" name="paymentTermsDays" placeholder="e.g. 30" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="preferredLanguage" class="mb-1 font-medium text-gray-700">Preferred Language</label>
            <select id="preferredLanguage" name="preferredLanguage" class="border p-2 rounded w-full">
              <option value="en" selected>English</option>
              <option value="ar">Arabic</option>
            </select>
          </div>

        </div>
      </div>

      <!-- OPERATIONAL -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Operational</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="assignedAgentId" class="mb-1 font-medium text-gray-700">Assigned Agent ID</label>
            <input type="number" id="assignedAgentId" name="assignedAgentId" placeholder="No users table yet" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="customerSince" class="mb-1 font-medium text-gray-700">Customer Since</label>
            <input type="date" id="customerSince" name="customerSince" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="metadata" class="mb-1 font-medium text-gray-700">Metadata (JSON)</label>
            <textarea id="metadata" name="metadata" placeholder='{"kycDocuments": []}' class="border p-2 rounded w-full font-mono text-sm"></textarea>
          </div>

        </div>
      </div>

      <!-- CRM INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">CRM Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="status" class="mb-1 font-medium text-gray-700">Status</label>
            <select id="status" name="status" class="border p-2 rounded w-full">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
              <option value="Lead">Lead</option>
              <option value="Prospect">Prospect</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="customerType" class="mb-1 font-medium text-gray-700">Customer Type</label>
            <select id="customerType" name="customerType" class="border p-2 rounded w-full">
              <option value="Business">Business</option>
              <option value="Individual">Individual</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="source" class="mb-1 font-medium text-gray-700">Source</label>
            <input type="text" id="source" name="source" placeholder="Source" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="notes" class="mb-1 font-medium text-gray-700">Notes</label>
            <textarea id="notes" name="notes" placeholder="Notes" class="border p-2 rounded w-full"></textarea>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="tags" class="mb-1 font-medium text-gray-700">Tags</label>
            <input type="text" id="tags" name="tags" placeholder="Tags (comma separated)" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- SUBMIT BUTTON -->
      <div class="flex justify-between items-center">
        <a href="/customers" class="text-gray-600 hover:text-gray-900">← Back to Customers</a>
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Save Customer
        </button>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
