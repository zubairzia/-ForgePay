<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <a href="/items" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Items
    </a>

    <div class="flex justify-between items-center mb-8 pb-4 border-b">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Item Details</h1>
        <p class="text-sm text-gray-500 mt-1"><%= item.item_code %></p>
      </div>

      <a href="/items/<%= item.id %>/edit"
         class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm hover:bg-blue-700 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit Item
      </a>
    </div>

    <form class="space-y-10">

      <div>
        <h2 class="text-lg font-semibold mb-4">Item Details</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Item Code</label>
            <input type="text" value="<%= item.item_code || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Name</label>
            <input type="text" value="<%= item.name || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col col-span-2">
            <label class="mb-1 font-medium text-gray-700">Description</label>
            <textarea class="border p-2 rounded w-full" disabled><%= item.description || '' %></textarea>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Item Type</label>
            <input type="text" value="<%= item.item_type || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">SKU</label>
            <input type="text" value="<%= item.sku || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Unit of Measure</label>
            <input type="text" value="<%= item.unit_of_measure || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Active</label>
            <input type="text" value="<%= item.is_active ? 'Yes' : 'No' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">Pricing</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Sales Price</label>
            <input type="text" value="<%= item.sales_price || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Purchase Price</label>
            <input type="text" value="<%= item.purchase_price || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Tax Rate (%)</label>
            <input type="text" value="<%= item.tax_rate || '' %>" class="border p-2 rounded w-full" disabled>
          </div>

        </div>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
