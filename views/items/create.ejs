<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Create New Item</h1>

    <form action="/items/create" method="POST" class="space-y-10">

      <div>
        <h2 class="text-lg font-semibold mb-4">Item Details</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="itemCode" class="mb-1 font-medium text-gray-700">Item Code</label>
            <input type="text" id="itemCode" name="itemCode" placeholder="e.g. ITM-001" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col">
            <label for="name" class="mb-1 font-medium text-gray-700">Name</label>
            <input type="text" id="name" name="name" placeholder="Item name" class="border p-2 rounded w-full" required>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="description" class="mb-1 font-medium text-gray-700">Description</label>
            <textarea id="description" name="description" placeholder="Description" class="border p-2 rounded w-full"></textarea>
          </div>

          <div class="flex flex-col">
            <label for="itemType" class="mb-1 font-medium text-gray-700">Item Type</label>
            <select id="itemType" name="itemType" class="border p-2 rounded w-full">
              <option value="goods" selected>Goods</option>
              <option value="service">Service</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="sku" class="mb-1 font-medium text-gray-700">SKU</label>
            <input type="text" id="sku" name="sku" placeholder="SKU" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="unitOfMeasure" class="mb-1 font-medium text-gray-700">Unit of Measure</label>
            <input type="text" id="unitOfMeasure" name="unitOfMeasure" placeholder="e.g. pcs, kg, hr" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="isActive" class="mb-1 font-medium text-gray-700">Active</label>
            <select id="isActive" name="isActive" class="border p-2 rounded w-full">
              <option value="true" selected>Yes</option>
              <option value="false">No</option>
            </select>
          </div>

        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">Pricing</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="salesPrice" class="mb-1 font-medium text-gray-700">Sales Price</label>
            <input type="number" step="0.01" id="salesPrice" name="salesPrice" placeholder="0.00" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="purchasePrice" class="mb-1 font-medium text-gray-700">Purchase Price</label>
            <input type="number" step="0.01" id="purchasePrice" name="purchasePrice" placeholder="0.00" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="taxRate" class="mb-1 font-medium text-gray-700">Tax Rate (%)</label>
            <input type="number" step="0.01" id="taxRate" name="taxRate" placeholder="0.00" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="/items" class="text-gray-600 hover:text-gray-900">← Back to Items</a>
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Save Item
        </button>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
