<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800"><%= meta.plural %></h1>
      <a href="<%= meta.basePath %>/create"
         class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
        + New <%= meta.singular %>
      </a>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Number</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= meta.direction === 'purchase' ? 'Vendor' : 'Customer' %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Issue Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Due Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (documents.length === 0) { %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-gray-500">No <%= meta.plural.toLowerCase() %> found</td>
            </tr>
          <% } else { %>
            <% documents.forEach(doc => { %>
              <tr class="cursor-pointer hover:bg-gray-50" onclick="window.location.href='<%= meta.basePath %>/<%= doc.id %>/view'">
                <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800"><%= doc.document_number %></td>
                <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= doc.party_name || '-' %></td>
                <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= doc.issue_date ? new Date(doc.issue_date).toLocaleDateString() : '-' %></td>
                <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= doc.due_date ? new Date(doc.due_date).toLocaleDateString() : '-' %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= doc.status === 'paid' ? 'bg-green-100 text-green-700'
                      : doc.status === 'cancelled' ? 'bg-gray-100 text-gray-500'
                      : doc.status === 'overdue' ? 'bg-red-100 text-red-700'
                      : doc.status === 'partially_paid' ? 'bg-amber-100 text-amber-700'
                      : doc.status === 'confirmed' || doc.status === 'sent' ? 'bg-blue-100 text-blue-700'
                      : 'bg-gray-100 text-gray-600' %>">
                    <%= doc.status.replace('_', ' ') %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right font-medium text-gray-800"><%= doc.currency || '' %> <%= Number(doc.total).toFixed(2) %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
