<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-6xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Create New <%= meta.singular %></h1>

    <form action="<%= meta.basePath %>/create" method="POST" class="space-y-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- PARTY + HEADER -->
      <div>
        <h2 class="text-lg font-semibold mb-4"><%= meta.singular %> Details</h2>
        <div class="grid grid-cols-2 gap-4">

          <% if (!fixedDirection) { %>
            <div class="flex flex-col">
              <label for="direction" class="mb-1 font-medium text-gray-700">Applies To</label>
              <select id="direction" name="direction" class="border p-2 rounded w-full">
                <option value="sales">A Customer (sales credit)</option>
                <option value="purchase">A Vendor (purchase credit)</option>
              </select>
            </div>
            <div></div>
          <% } %>

          <% if (fixedDirection === 'sales' || !fixedDirection) { %>
            <div class="flex flex-col party-field party-field-sales" <%= (!fixedDirection) ? '' : '' %>>
              <label for="customerId" class="mb-1 font-medium text-gray-700">Customer</label>
              <select id="customerId" name="customerId" class="border p-2 rounded w-full">
                <option value="">Select a customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.company_name || (c.first_name + ' ' + c.last_name) %></option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <% if (fixedDirection === 'purchase' || !fixedDirection) { %>
            <div class="flex flex-col party-field party-field-purchase" <%= (!fixedDirection) ? 'style="display:none"' : '' %>>
              <label for="vendorId" class="mb-1 font-medium text-gray-700">Vendor</label>
              <select id="vendorId" name="vendorId" class="border p-2 rounded w-full">
                <option value="">Select a vendor</option>
                <% vendors.forEach(v => { %>
                  <option value="<%= v.id %>"><%= v.company_name || (v.first_name + ' ' + v.last_name) %></option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <div class="flex flex-col">
            <label for="issueDate" class="mb-1 font-medium text-gray-700">Issue Date</label>
            <input type="date" id="issueDate" name="issueDate" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="dueDate" class="mb-1 font-medium text-gray-700">Due Date</label>
            <input type="date" id="dueDate" name="dueDate" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="currency" class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" id="currency" name="currency" placeholder="e.g. USD" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="referenceNumber" class="mb-1 font-medium text-gray-700">Reference Number</label>
            <input type="text" id="referenceNumber" name="referenceNumber" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="notes" class="mb-1 font-medium text-gray-700">Notes</label>
            <textarea id="notes" name="notes" class="border p-2 rounded w-full"></textarea>
          </div>

          <div class="flex flex-col col-span-2">
            <label for="terms" class="mb-1 font-medium text-gray-700">Terms</label>
            <textarea id="terms" name="terms" class="border p-2 rounded w-full"></textarea>
          </div>

        </div>
      </div>

      <!-- LINE ITEMS -->
      <div>
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-semibold">Line Items</h2>
          <button type="button" id="addLineBtn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded text-sm font-medium">
            + Add Line
          </button>
        </div>

        <div class="overflow-x-auto border rounded">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Qty</th>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Unit Price</th>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Disc %</th>
                <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Tax %</th>
                <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Line Total</th>
                <th class="p-2"></th>
              </tr>
            </thead>
            <tbody id="lineItemsBody"></tbody>
          </table>
        </div>

        <div class="flex justify-end mt-4">
          <div class="w-64 space-y-1 text-sm">
            <div class="flex justify-between"><span class="text-gray-500">Subtotal</span><span id="previewSubtotal">0.00</span></div>
            <div class="flex justify-between"><span class="text-gray-500">Tax</span><span id="previewTaxTotal">0.00</span></div>
            <div class="flex justify-between font-semibold text-base border-t pt-1"><span>Total</span><span id="previewTotal">0.00</span></div>
          </div>
        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="<%= meta.basePath %>" class="text-gray-600 hover:text-gray-900">← Back to <%= meta.plural %></a>
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Save <%= meta.singular %>
        </button>
      </div>

    </form>

  </div>

</main>

<script id="itemsData" type="application/json"><%- JSON.stringify(items) %></script>
<script src="/js/documents.js"></script>
<script>
  // Seed one empty line row on load, and wire up the direction toggle for
  // credit notes (the one type with no fixed direction).
  window.addEventListener('DOMContentLoaded', () => {
    window.__documentsFormAddRow();

    const directionSelect = document.getElementById('direction');
    if (directionSelect) {
      const salesField = document.querySelector('.party-field-sales');
      const purchaseField = document.querySelector('.party-field-purchase');
      directionSelect.addEventListener('change', () => {
        if (directionSelect.value === 'sales') {
          salesField.style.display = '';
          purchaseField.style.display = 'none';
        } else {
          salesField.style.display = 'none';
          purchaseField.style.display = '';
        }
      });
    }
  });
</script>

<%- include('../partials/footer') %>
