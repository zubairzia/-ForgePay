<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <a href="<%= meta.basePath %>" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to <%= meta.plural %>
    </a>

    <div class="flex justify-between items-center mb-8 pb-4 border-b">
      <div>
        <h1 class="text-2xl font-bold text-gray-800"><%= meta.singular %> <%= document.document_number %></h1>
        <p class="text-sm text-gray-500 mt-1">
          <%= document.direction === 'purchase' ? 'Vendor' : 'Customer' %>: <%= partyName || '-' %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
          <%= document.status === 'paid' ? 'bg-green-100 text-green-700'
            : document.status === 'cancelled' ? 'bg-gray-100 text-gray-500'
            : document.status === 'overdue' ? 'bg-red-100 text-red-700'
            : document.status === 'partially_paid' ? 'bg-amber-100 text-amber-700'
            : document.status === 'confirmed' || document.status === 'sent' ? 'bg-blue-100 text-blue-700'
            : 'bg-gray-100 text-gray-600' %>">
          <%= document.status.replace('_', ' ') %>
        </span>

        <a href="<%= meta.basePath %>/<%= document.id %>/edit"
           class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm hover:bg-blue-700 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Edit
        </a>
      </div>
    </div>

    <% if (allowedNextStatuses.length > 0) { %>
      <form action="<%= meta.basePath %>/<%= document.id %>/status" method="POST" class="flex items-center gap-3 mb-8 bg-gray-50 border rounded-lg p-4">
        <label for="status" class="text-sm font-medium text-gray-700">Change status to:</label>
        <select id="status" name="status" class="border p-2 rounded text-sm">
          <% allowedNextStatuses.forEach(s => { %>
            <option value="<%= s %>"><%= s.replace('_', ' ') %></option>
          <% }) %>
        </select>
        <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded text-sm font-medium hover:bg-gray-900 transition">
          Update Status
        </button>
      </form>
    <% } %>

    <div class="grid grid-cols-2 gap-4 mb-8 text-sm">
      <div><span class="text-gray-500">Issue Date:</span> <%= document.issue_date ? new Date(document.issue_date).toLocaleDateString() : '-' %></div>
      <div><span class="text-gray-500">Due Date:</span> <%= document.due_date ? new Date(document.due_date).toLocaleDateString() : '-' %></div>
      <div><span class="text-gray-500">Currency:</span> <%= document.currency || '-' %></div>
      <div><span class="text-gray-500">Reference:</span> <%= document.reference_number || '-' %></div>
    </div>

    <h2 class="text-lg font-semibold mb-4">Line Items</h2>
    <div class="overflow-x-auto border rounded mb-6">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
            <th class="p-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
            <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Qty</th>
            <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
            <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Disc %</th>
            <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Tax %</th>
            <th class="p-2 text-right text-xs font-medium text-gray-500 uppercase">Line Total</th>
          </tr>
        </thead>
        <tbody>
          <% document.lines.forEach(line => { %>
            <tr class="border-b">
              <td class="p-2"><%= line.item_name || '-' %></td>
              <td class="p-2"><%= line.description || '-' %></td>
              <td class="p-2 text-right"><%= line.quantity %></td>
              <td class="p-2 text-right"><%= line.unit_price %></td>
              <td class="p-2 text-right"><%= line.discount_percent %></td>
              <td class="p-2 text-right"><%= line.tax_rate %></td>
              <td class="p-2 text-right font-medium"><%= line.line_total %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="flex justify-end">
      <div class="w-64 space-y-1 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Subtotal</span><span><%= Number(document.subtotal).toFixed(2) %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Tax</span><span><%= Number(document.tax_total).toFixed(2) %></span></div>
        <div class="flex justify-between font-semibold text-base border-t pt-1"><span>Total</span><span><%= document.currency || '' %> <%= Number(document.total).toFixed(2) %></span></div>
      </div>
    </div>

    <% if (document.notes) { %>
      <div class="mt-8 pt-6 border-t">
        <h3 class="text-sm font-semibold text-gray-700 mb-1">Notes</h3>
        <p class="text-sm text-gray-600"><%= document.notes %></p>
      </div>
    <% } %>

    <% if (document.terms) { %>
      <div class="mt-4">
        <h3 class="text-sm font-semibold text-gray-700 mb-1">Terms</h3>
        <p class="text-sm text-gray-600"><%= document.terms %></p>
      </div>
    <% } %>

  </div>

</main>

<%- include('../partials/footer') %>
