<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">New Credit Account</h1>
      <p class="text-sm text-gray-500 mt-1">Open an installment credit account with a fixed, disclosed markup.</p>
    </div>

    <div id="formError" class="hidden mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"></div>

    <div class="bg-white p-8 rounded-lg shadow space-y-8">

      <!-- ACCOUNT -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Account</h2>
        <div class="flex flex-col max-w-xs">
          <label for="accountNumber" class="mb-1 font-medium text-gray-700">Account Number</label>
          <input type="text" id="accountNumber" class="border p-2 rounded w-full" placeholder="CA-0001">
        </div>
      </div>

      <!-- CUSTOMER -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Customer</h2>
        <div class="relative">
          <input type="text" id="customerSearch" placeholder="Search customer by name, email, phone..."
                 class="border p-2 rounded w-full" autocomplete="off">
          <div id="customerResults" class="hidden absolute z-10 bg-white border rounded shadow mt-1 w-full max-h-56 overflow-y-auto"></div>
        </div>
        <div id="customerSelected" class="hidden mt-2 flex items-center gap-2 bg-indigo-50 text-indigo-800 px-3 py-2 rounded text-sm">
          <span id="customerSelectedName" class="font-medium"></span>
          <button type="button" id="customerClear" class="ml-auto text-indigo-500 hover:text-indigo-700">&times; change</button>
        </div>

        <div class="mt-4">
          <label for="invoiceSelect" class="mb-1 block font-medium text-gray-700 text-sm">Link to existing invoice (optional)</label>
          <select id="invoiceSelect" class="border p-2 rounded w-full" disabled>
            <option value="">— Select a customer first —</option>
          </select>
        </div>
      </div>

      <!-- TERMS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Terms</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="principalAmount" class="mb-1 font-medium text-gray-700">Principal Amount</label>
            <input type="number" step="0.01" min="0" id="principalAmount" class="border p-2 rounded w-full" placeholder="0.00">
          </div>

          <div class="flex flex-col">
            <label for="downPaymentAmount" class="mb-1 font-medium text-gray-700">Down Payment</label>
            <input type="number" step="0.01" min="0" id="downPaymentAmount" class="border p-2 rounded w-full" placeholder="0.00" value="0">
          </div>

          <div class="flex flex-col">
            <label for="markupAmount" class="mb-1 font-medium text-gray-700">Markup Amount</label>
            <input type="number" step="0.01" min="0" id="markupAmount" class="border p-2 rounded w-full" placeholder="0.00">
            <span class="text-xs text-gray-400 mt-1">Fixed amount disclosed at origination. Not a percentage rate.</span>
          </div>

          <div class="flex flex-col">
            <label for="startDate" class="mb-1 font-medium text-gray-700">Start Date</label>
            <input type="date" id="startDate" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="installmentType" class="mb-1 font-medium text-gray-700">Installment Type</label>
            <select id="installmentType" class="border p-2 rounded w-full">
              <option value="one_time">One-time (single payment)</option>
              <option value="recurring" selected>Recurring</option>
            </select>
          </div>

          <div></div>

          <div class="flex flex-col recurring-field">
            <label for="installmentFrequency" class="mb-1 font-medium text-gray-700">Installment Frequency</label>
            <select id="installmentFrequency" class="border p-2 rounded w-full">
              <option value="weekly">Weekly</option>
              <option value="biweekly">Biweekly</option>
              <option value="monthly" selected>Monthly</option>
              <option value="yearly">Yearly</option>
            </select>
          </div>

          <div class="flex flex-col recurring-field">
            <label for="installmentCount" class="mb-1 font-medium text-gray-700">Number of Installments</label>
            <input type="number" min="1" step="1" id="installmentCount" class="border p-2 rounded w-full" value="3">
          </div>

        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="/credit-accounts" class="text-gray-600 hover:text-gray-900">&larr; Back to Credit Accounts</a>
        <button type="button" id="previewBtn" class="bg-gray-800 text-white px-6 py-2 rounded hover:bg-gray-900 transition">
          Preview Schedule
        </button>
      </div>

    </div>

    <!-- SCHEDULE PREVIEW -->
    <div id="previewPanel" class="hidden bg-white p-8 rounded-lg shadow mt-6">
      <h2 class="text-lg font-semibold mb-4">Schedule Preview</h2>

      <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Financed Amount</div>
          <div id="previewFinanced" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Total Payable</div>
          <div id="previewTotalPayable" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Per Installment</div>
          <div id="previewPerInstallment" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Maturity Date</div>
          <div id="previewMaturity" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
      </div>

      <div class="overflow-x-auto border rounded">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">#</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Due Date</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Principal</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Markup</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
            </tr>
          </thead>
          <tbody id="previewScheduleBody" class="bg-white divide-y divide-gray-200"></tbody>
        </table>
      </div>

      <div class="flex justify-end mt-6">
        <button type="button" id="confirmBtn" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Confirm and Activate
        </button>
      </div>
    </div>

  </div>
</main>

<script src="/js/creditaccounts-create.js"></script>

<%- include('../partials/footer') %>
