<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Reschedule Credit Account</h1>
      <p class="text-sm text-gray-500 mt-1">Replace the remaining unpaid installments with a new schedule. Paid installments are never touched.</p>
    </div>

    <div id="formError" class="hidden mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"></div>

    <div class="bg-white p-8 rounded-lg shadow space-y-6">

      <div class="grid grid-cols-3 gap-4">
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Account</div>
          <div id="currentAccountNumber" class="text-lg font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Remaining Installments</div>
          <div id="currentRemainingCount" class="text-lg font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Remaining Balance</div>
          <div id="currentRemainingBalance" class="text-lg font-bold text-gray-800 mt-1">-</div>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">New Terms</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="startDate" class="mb-1 font-medium text-gray-700">New Start Date</label>
            <input type="date" id="startDate" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="installmentCount" class="mb-1 font-medium text-gray-700">Number of Installments</label>
            <input type="number" min="1" step="1" id="installmentCount" class="border p-2 rounded w-full" value="3">
          </div>

          <div class="flex flex-col installment-frequency-field">
            <label for="installmentFrequency" class="mb-1 font-medium text-gray-700">Installment Frequency</label>
            <select id="installmentFrequency" class="border p-2 rounded w-full">
              <option value="weekly">Weekly</option>
              <option value="biweekly">Biweekly</option>
              <option value="monthly" selected>Monthly</option>
              <option value="yearly">Yearly</option>
            </select>
            <span class="text-xs text-gray-400 mt-1">Ignored when Number of Installments is 1.</span>
          </div>

        </div>
      </div>

      <div class="flex justify-between items-center">
        <a href="#" id="backLink" class="text-gray-600 hover:text-gray-900">&larr; Back to Account</a>
        <button type="button" id="previewBtn" class="bg-gray-800 text-white px-6 py-2 rounded hover:bg-gray-900 transition">
          Preview New Schedule
        </button>
      </div>

    </div>

    <!-- PREVIEW -->
    <div id="previewPanel" class="hidden bg-white p-8 rounded-lg shadow mt-6">
      <h2 class="text-lg font-semibold mb-4">New Schedule Preview</h2>

      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Remaining Total</div>
          <div id="previewTotal" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">Per Installment</div>
          <div id="previewPerInstallment" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
        <div class="bg-gray-50 rounded p-4">
          <div class="text-xs text-gray-500 uppercase">New Maturity Date</div>
          <div id="previewMaturity" class="text-xl font-bold text-gray-800 mt-1">-</div>
        </div>
      </div>

      <div class="overflow-x-auto border rounded">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">#</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Due Date</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Principal</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Markup</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Penalty</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
            </tr>
          </thead>
          <tbody id="previewScheduleBody" class="bg-white divide-y divide-gray-200"></tbody>
        </table>
      </div>

      <p class="text-xs text-gray-400 mt-4">The installments below will be marked as superseded history, not deleted:</p>
      <div id="supersededList" class="text-sm text-gray-500 mb-4"></div>

      <div class="flex justify-end mt-2">
        <button type="button" id="confirmBtn" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
          Confirm Reschedule
        </button>
      </div>
    </div>

  </div>
</main>

<script>window.__creditAccountId = <%- JSON.stringify(id) %>;</script>
<script src="/js/creditaccounts-reschedule.js"></script>

<%- include('../partials/footer') %>
