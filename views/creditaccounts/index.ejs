<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Credit Accounts</h1>
        <p class="text-sm text-gray-500 mt-1">Installment credit sales and their repayment status.</p>
      </div>
      <a href="/credit-accounts/create"
         class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
        + New Credit Account
      </a>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account #</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Financed</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Outstanding</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Next Due</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Days Overdue</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          </tr>
        </thead>
        <tbody id="creditAccountsTable" class="bg-white divide-y divide-gray-200">
          <!-- JS will populate rows -->
        </tbody>
      </table>
    </div>

  </div>
</main>

<script src="/js/creditaccounts.js"></script>

<%- include('../partials/footer') %>
