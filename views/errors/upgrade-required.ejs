<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-3xl mx-auto mt-16 bg-white p-10 rounded-lg shadow text-center">
    <div class="mx-auto mb-4 flex items-center justify-center w-14 h-14 rounded-full bg-indigo-50">
      <svg class="w-7 h-7 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v4h8z"/>
      </svg>
    </div>
    <span class="inline-block mb-3 px-2.5 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-indigo-100 text-indigo-700">
      <%= requiredPlan %> plan
    </span>
    <h1 class="text-xl font-semibold text-gray-800 mb-2"><%= moduleName %> is a Pro feature</h1>
    <p class="text-gray-500 mb-8 max-w-md mx-auto">
      Your current plan doesn't include <%= moduleName %>. Upgrade to Pro to track vendors,
      bills, expenses, purchase orders, and vendor credits alongside your customer accounts.
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href="/customers"
         class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 px-5 py-2.5 rounded-lg font-medium hover:bg-gray-50 transition">
        Back to Customers
      </a>
      <span class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm opacity-90 cursor-not-allowed"
            title="Billing isn't set up yet — contact your account manager to upgrade">
        Upgrade to Pro
      </span>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
