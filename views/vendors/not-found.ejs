<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-3xl mx-auto mt-16 bg-white p-10 rounded-lg shadow text-center">
    <div class="mx-auto mb-4 flex items-center justify-center w-14 h-14 rounded-full bg-amber-50">
      <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
      </svg>
    </div>
    <h1 class="text-xl font-semibold text-gray-800 mb-2">Vendor not found</h1>
    <p class="text-gray-500 mb-8">
      We couldn't find a vendor with ID <span class="font-mono">"<%= vendorCode %>"</span>.
      It may have been removed, or the ID in the link is incorrect.
    </p>
    <a href="/vendors"
       class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm hover:bg-blue-700 transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Vendors
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
