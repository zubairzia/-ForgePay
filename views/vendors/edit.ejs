<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">

  <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-8">Edit Vendor</h1>

    <form action="/vendors/<%= vendor.vendor_code %>/update" method="POST" class="space-y-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- BASIC INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Basic Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="firstName" class="mb-1 font-medium text-gray-700">First Name</label>
            <input type="text" id="firstName" name="firstName" value="<%= vendor.first_name || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="lastName" class="mb-1 font-medium text-gray-700">Last Name</label>
            <input type="text" id="lastName" name="lastName" value="<%= vendor.last_name || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="companyName" class="mb-1 font-medium text-gray-700">Company Name</label>
            <input type="text" id="companyName" name="companyName" value="<%= vendor.company_name || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="displayName" class="mb-1 font-medium text-gray-700">Display Name</label>
            <input type="text" id="displayName" name="displayName" value="<%= vendor.display_name || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="email" class="mb-1 font-medium text-gray-700">Email</label>
            <input type="email" id="email" name="email" value="<%= vendor.email || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="phone" class="mb-1 font-medium text-gray-700">Phone</label>
            <input type="text" id="phone" name="phone" value="<%= vendor.phone || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="mobile" class="mb-1 font-medium text-gray-700">Mobile</label>
            <input type="text" id="mobile" name="mobile" value="<%= vendor.mobile || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="website" class="mb-1 font-medium text-gray-700">Website</label>
            <input type="text" id="website" name="website" value="<%= vendor.website || '' %>" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- BILLING ADDRESS -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Billing Address</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col col-span-2">
            <label for="billingStreet" class="mb-1 font-medium text-gray-700">Street</label>
            <input type="text" id="billingStreet" name="billingStreet" value="<%= vendor.billing_street || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingCity" class="mb-1 font-medium text-gray-700">City</label>
            <input type="text" id="billingCity" name="billingCity" value="<%= vendor.billing_city || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingState" class="mb-1 font-medium text-gray-700">State</label>
            <input type="text" id="billingState" name="billingState" value="<%= vendor.billing_state || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingPostalCode" class="mb-1 font-medium text-gray-700">Postal Code</label>
            <input type="text" id="billingPostalCode" name="billingPostalCode" value="<%= vendor.billing_postal_code || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="billingCountry" class="mb-1 font-medium text-gray-700">Country</label>
            <input type="text" id="billingCountry" name="billingCountry" value="<%= vendor.billing_country || '' %>" class="border p-2 rounded w-full">
          </div>

        </div>
      </div>

      <!-- FINANCIAL INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Financial Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="taxNumber" class="mb-1 font-medium text-gray-700">Tax Number</label>
            <input type="text" id="taxNumber" name="taxNumber" value="<%= vendor.tax_number || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="taxid" class="mb-1 font-medium text-gray-700">Tax ID</label>
            <input type="text" id="taxid" name="taxid" value="<%= vendor.tax_id || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="currency" class="mb-1 font-medium text-gray-700">Currency</label>
            <input type="text" id="currency" name="currency" value="<%= vendor.currency || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col">
            <label for="IsTaxable" class="mb-1 font-medium text-gray-700">Is Taxable</label>
            <select id="IsTaxable" name="IsTaxable" class="border p-2 rounded w-full">
              <option value="Yes" <%= vendor.is_taxable ? 'selected' : '' %>>Yes</option>
              <option value="No" <%= !vendor.is_taxable ? 'selected' : '' %>>No</option>
            </select>
          </div>

        </div>
      </div>

      <!-- OTHER INFORMATION -->
      <div>
        <h2 class="text-lg font-semibold mb-4">Other Information</h2>
        <div class="grid grid-cols-2 gap-4">

          <div class="flex flex-col">
            <label for="status" class="mb-1 font-medium text-gray-700">Status</label>
            <select id="status" name="status" class="border p-2 rounded w-full">
              <option value="active" <%= vendor.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= vendor.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>

          <div class="flex flex-col">
            <label for="source" class="mb-1 font-medium text-gray-700">Source</label>
            <input type="text" id="source" name="source" value="<%= vendor.source || '' %>" class="border p-2 rounded w-full">
          </div>

          <div class="flex flex-col col-span-2">
            <label for="notes" class="mb-1 font-medium text-gray-700">Notes</label>
            <textarea id="notes" name="notes" class="border p-2 rounded w-full"><%= vendor.notes || '' %></textarea>
          </div>

        </div>
      </div>

      <!-- SUBMIT BUTTON -->
      <div class="flex justify-between items-center">
        <a href="/vendors" class="text-gray-600 hover:text-gray-900">← Back to Vendors</a>
        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition">
          Update Vendor
        </button>
      </div>

    </form>

  </div>

</main>

<%- include('../partials/footer') %>
