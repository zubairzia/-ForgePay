<%- include('../partials/header') %>

<main class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-10">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow">
    <h1 class="text-2xl font-bold text-gray-800 mb-1">Forge Pay</h1>
    <p class="text-sm text-gray-500 mb-6">Register your company</p>

    <% if (error) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"><%= error %></div>
    <% } %>

    <form action="/register" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex flex-col">
        <label for="companyName" class="mb-1 font-medium text-gray-700 text-sm">Company Name</label>
        <input type="text" id="companyName" name="companyName" value="<%= formValues.companyName || '' %>" class="border p-2 rounded w-full" required autofocus>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col">
          <label for="firstName" class="mb-1 font-medium text-gray-700 text-sm">First Name</label>
          <input type="text" id="firstName" name="firstName" value="<%= formValues.firstName || '' %>" class="border p-2 rounded w-full">
        </div>
        <div class="flex flex-col">
          <label for="lastName" class="mb-1 font-medium text-gray-700 text-sm">Last Name</label>
          <input type="text" id="lastName" name="lastName" value="<%= formValues.lastName || '' %>" class="border p-2 rounded w-full">
        </div>
      </div>

      <div class="flex flex-col">
        <label for="email" class="mb-1 font-medium text-gray-700 text-sm">Email</label>
        <input type="email" id="email" name="email" value="<%= formValues.email || '' %>" class="border p-2 rounded w-full" required>
      </div>

      <div class="flex flex-col">
        <label for="password" class="mb-1 font-medium text-gray-700 text-sm">Password</label>
        <input type="password" id="password" name="password" class="border p-2 rounded w-full" minlength="8" required>
        <span class="text-xs text-gray-400 mt-1">At least 8 characters</span>
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition font-medium">
        Create company &amp; account
      </button>
    </form>

    <p class="text-sm text-gray-500 mt-6 text-center">
      Already registered? <a href="/login" class="text-blue-600 hover:underline">Log in</a>
    </p>
  </div>
</main>

<%- include('../partials/footer') %>
