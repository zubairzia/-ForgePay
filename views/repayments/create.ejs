<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="lg:ml-64 p-8 bg-gray-100 min-h-screen">
  <div class="max-w-4xl mx-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Record Repayment</h1>
      <p class="text-sm text-gray-500 mt-1">Search for a credit account, then enter the amount received.</p>
    </div>

    <div id="formError" class="hidden mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm"></div>
    <div id="confirmationPanel" class="hidden mb-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded text-sm"></div>

    <!-- SEARCH -->
    <div id="searchSection" class="bg-white p-6 rounded-lg shadow">
      <div class="relative">
        <input type="text" id="accountSearch" placeholder="Search by customer name or account number..."
               class="border p-2 rounded w-full" autocomplete="off">
        <div id="accountResults" class="hidden absolute z-10 bg-white border rounded shadow mt-1 w-full max-h-64 overflow-y-auto"></div>
      </div>
    </div>

    <!-- SELECTED ACCOUNT + REPAYMENT FORM -->
    <div id="repaymentSection" class="hidden mt-6 space-y-6">

      <div class="bg-white p-6 rounded-lg shadow">
        <div class="flex justify-between items-start mb-4">
          <div>
            <div class="flex items-center gap-2">
              <span id="selAccountNumber" class="font-bold text-gray-800"></span>
              <span id="selStatusBadge"></span>
            </div>
            <div id="selCustomerName" class="text-sm text-gray-500"></div>
          </div>
          <button type="button" id="changeAccountBtn" class="text-indigo-500 hover:text-indigo-700 text-sm">&times; change account</button>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div class="bg-gray-50 rounded p-4">
            <div class="text-xs text-gray-500 uppercase">Current Amount Due</div>
            <div id="currentAmountDue" class="text-xl font-bold text-gray-800 mt-1">-</div>
          </div>
          <div class="bg-gray-50 rounded p-4">
            <div class="text-xs text-gray-500 uppercase">Total Overdue</div>
            <div id="totalOverdue" class="text-xl font-bold text-red-600 mt-1">-</div>
          </div>
          <div class="bg-gray-50 rounded p-4">
            <div class="text-xs text-gray-500 uppercase">Account Balance</div>
            <div id="accountBalance" class="text-xl font-bold text-gray-800 mt-1">-</div>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-lg font-semibold mb-4">Payment Details</h2>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col">
            <label for="amount" class="mb-1 font-medium text-gray-700">Amount Received</label>
            <input type="number" step="0.01" min="0.01" id="amount" class="border p-2 rounded w-full" placeholder="0.00">
          </div>
          <div class="flex flex-col">
            <label for="paymentDate" class="mb-1 font-medium text-gray-700">Date</label>
            <input type="date" id="paymentDate" class="border p-2 rounded w-full">
          </div>
          <div class="flex flex-col">
            <label for="paymentMethod" class="mb-1 font-medium text-gray-700">Method</label>
            <select id="paymentMethod" class="border p-2 rounded w-full">
              <option value="cash">Cash</option>
              <option value="bank_transfer">Bank Transfer</option>
              <option value="card">Card</option>
              <option value="mobile_wallet">Mobile Wallet</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="flex flex-col">
            <label for="referenceNumber" class="mb-1 font-medium text-gray-700">Reference Number</label>
            <input type="text" id="referenceNumber" class="border p-2 rounded w-full" placeholder="Optional">
          </div>
        </div>
        <div class="flex justify-end mt-6">
          <button type="button" id="previewBtn" class="bg-gray-800 text-white px-6 py-2 rounded hover:bg-gray-900 transition">
            Preview Allocation
          </button>
        </div>
      </div>

      <!-- ALLOCATION PREVIEW -->
      <div id="allocationPanel" class="hidden bg-white p-6 rounded-lg shadow">
        <h2 class="text-lg font-semibold mb-4">Allocation Preview</h2>
        <p class="text-sm text-gray-500 mb-4">Waterfall order: <span id="waterfallOrder" class="font-medium"></span></p>
        <div class="overflow-x-auto border rounded">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Installment #</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Due Date</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Applied Penalty</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Applied Markup</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Applied Principal</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total Applied</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status After</th>
              </tr>
            </thead>
            <tbody id="allocationBody" class="bg-white divide-y divide-gray-200"></tbody>
          </table>
        </div>
        <div id="unappliedRow" class="hidden mt-3 text-sm text-yellow-700 bg-yellow-50 border border-yellow-200 rounded px-3 py-2"></div>

        <div class="flex justify-end mt-6">
          <button type="button" id="postBtn" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
            Post Repayment
          </button>
        </div>
      </div>

    </div>

  </div>
</main>

<script>window.__prefillCreditAccountId = <%- JSON.stringify(creditAccountId || '') %>;</script>
<script src="/js/repayments-create.js"></script>

<%- include('../partials/footer') %>
